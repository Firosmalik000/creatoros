APP_ENV=production
WEB_PORT=3000
API_PORT=8080
API_BASE_URL=http://api:8080/api/v1
NEXT_PUBLIC_SITE_URL=https://agensi.xboss.asia
PUBLIC_WEB_URL=https://agensi.xboss.asia
WEB_ORIGINS=https://agensi.xboss.asia
COOKIE_SECURE=true

# Database Credentials
POSTGRES_DB=creatoros
POSTGRES_USER=creatoros
POSTGRES_PASSWORD=GantiDenganPasswordKuatPostgres123!
DATABASE_URL=postgres://creatoros:GantiDenganPasswordKuatPostgres123!@postgres:5432/creatoros?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=creatoros-media
S3_ACCESS_KEY=creatoros_admin
S3_SECRET_KEY=GantiDenganSecretMinioKuat123!

# Encryption & Outbox (32-byte base64 encoded)
OUTBOX_ENCRYPTION_KEY=eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHg=

# SMTP Email (Optional / Production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@agensi.xboss.asia
